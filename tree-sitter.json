{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "fountain",
      "camelcase": "Fountain",
      "title": "Fountain",
      "scope": "source.fountain",
      "file-types": [
        "fountain",
        "spmd"
      ],
      "injection-regex": "^fountain$",
      "class-name": "TreeSitterFountain"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A Markdown format for screenplays",
    "authors": [
      {
        "name": "Joop Kiefte",
        "email": "ikojba@gmail.com",
        "url": "https://joop.kiefte.eu/"
      }
    ],
    "links": {
      "repository": "https://github.com/LaPingvino/tree-sitter-fountain"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}