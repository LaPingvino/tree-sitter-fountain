    "_text": {
      "type": "PATTERN",
      "value": "[^ \\t\\n\\r*_\\[\\\\/#<(^]+([ \\t]+[^ \\t\\n\\r*_\\[\\\\/#<(^]+)*"
    },
    "_whitespace": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    "_special": {
      "type": "PATTERN",
      "value": "[*_\\[\\\\/#<(^]"
    },
    "escape": {
      "type": "PATTERN",
      "value": "\\\\[^\\n\\r]"
    },
    "bold_italic": {
      "type": "PATTERN",
      "value": "\\*\\*\\*[^\\s*]([^*\\n\\r]*[^\\s*])?\\*\\*\\*"
    },
    "bold": {
      "type": "PATTERN",
      "value": "\\*\\*[^\\s*]([^*\\n\\r]*[^\\s*])?\\*\\*"
    },
    "italic": {
      "type": "PATTERN",
      "value": "\\*[^\\s*]([^*\\n\\r]*[^\\s*])?\\*"
    },
    "underline": {
      "type": "PATTERN",
      "value": "_[^\\s_]([^_\\n\\r]*[^\\s_])?_"
    },
    "note": {
      "type": "PATTERN",
      "value": "\\[\\[([^\\]\\n]|\\][^\\]\\n]|\\n[^\\n\\]]|\\n\\][^\\]\\n])*\\n?\\]\\]"
    },
    "boneyard": {
      "type": "PATTERN",
      "value": "\\/\\*([^*]|\\*+[^*\\/])*\\*+\\/"
    }
